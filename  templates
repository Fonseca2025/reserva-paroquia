<!DOCTYPE html>
<html>
<head>
    <title>Reserva São Judas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --cor-paroquia-verde: #1b4d3e;
            --cor-paroquia-vinho: #7a1b1b;
        }
        body { background-color: #f8f9fa; }
        .navbar { background-color: var(--cor-paroquia-verde) !important; }
        .btn-primary { background-color: var(--cor-paroquia-vinho); border: none; }
        .btn-primary:hover { background-color: #5a1414; }
        .header-logo { color: white; font-weight: bold; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand header-logo" href="/">Paróquia São Judas Tadeu</a>
        </div>
    </nav>
    <div class="container">
        {% with messages = get_flashed_messages() %}
          {% if messages %}
            {% for message in messages %}
              <div class="alert alert-info">{{ message|safe }}</div>
            {% endfor %}
          {% endif %}
        {% endwith %}
        {% block content %}{% endblock %}
    </div>
</body>
</html>